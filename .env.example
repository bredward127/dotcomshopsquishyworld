# Public site origin. Used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://shopsquishyworld.com

# Google tag (gtag.js) measurement ID. Loaded in the root layout.
# Leave empty to disable analytics entirely - the script is only injected when set.
NEXT_PUBLIC_GOOGLE_TAG_ID=AW-10803481355

# Both values above are exposed to the browser by design (NEXT_PUBLIC_ prefix).
# Never put secrets, API keys, or tokens in NEXT_PUBLIC_ variables.

# --- Optional server-side keys. Never prefixed NEXT_PUBLIC_, never sent to the browser. ---

# Anthropic API key. When set, /ask can compose a reply from a visitor's typed
# question - but only if that visitor also ticks the consent box. Leave unset and
# /ask returns curated responses written in advance, labeled as such.
# ANTHROPIC_API_KEY=

# YouTube Data API v3 key. When set, /api/videos searches a fixed allowlist of
# approved phrases chosen by topic. Visitor text is never sent to YouTube.
# Leave unset and the video section shows an honest unavailable state.
# YOUTUBE_API_KEY=

# Set to 1 to log every analytics event decision to the console and to
# window.__samAnalytics instead of guessing what fired. Development only.
# NEXT_PUBLIC_ANALYTICS_QA=1
